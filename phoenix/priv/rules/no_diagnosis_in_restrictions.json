{
  "key": "no_diagnosis_in_restrictions",
  "version": 1,
  "label": "No diagnosis in duty restrictions",
  "description": "Fitness-for-duty restrictions are read by commanders; they say what the person may do, never why. A restriction text containing an ICD-10-like code (a letter and two digits, e.g. S83.2) is a probable disclosure of a diagnosis.",
  "severity": "flag",
  "points": [
    "record.save"
  ],
  "subjects": [
    "record:fitness_for_duty"
  ],
