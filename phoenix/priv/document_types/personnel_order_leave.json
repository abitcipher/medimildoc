{
  "id": "personnel_order_leave",
  "version": "1",
  "label": "Order: leave",
  "icon": "hero-sun",
  "summary": "Grants leave for a period; the leave is recorded when signed.",
  "category": "personnel",
  "access": {
    "read": [
      "people.hr_private.read",
      "orders.sign"
    ],
    "write": "people.write"
  },
  "register": {
    "code": "ос",
    "format": "{seq}-{code}"
  },
  "retention_years": 75,
  "template": "personnel_order.typ",
  "route": [
    {
      "action": "approve",
      "label": "Head of HR",
      "permission": "people.write"
    },
    {
      "action": "sign",
      "label": "Commander",
      "permission": "orders.sign"
    }
  ],
  "effects": [
    "leave_record"
  ],
  "acknowledge": true,
  "basis": [
    "leave_request"
  ],
  "schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": [
      "leaveType",
      "startDate",
      "endDate"
    ],
    "properties": {
      "leaveType": {
        "type": "string",
        "enum": [
          "annual",
          "family",
          "study",
          "sick",
          "unpaid"
        ],
        "x-enum-labels": {
          "annual": "Annual leave",
          "family": "Family circumstances",
          "study": "Study leave",
          "sick": "Sick leave",
          "unpaid": "Unpaid leave"
        }
      },
      "startDate": {
        "type": "string",
        "format": "date"
      },
      "endDate": {
        "type": "string",
        "format": "date"
      },
      "destination": {
        "type": "string",
        "maxLength": 300,
        "x-help": "Where the person will be, e.g. a town and region."
      },
      "note": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "additionalProperties": false
  },
  "ui": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Control",
        "scope": "#/properties/leaveType",
        "label": "Type of leave"
      },
      {
        "type": "HorizontalLayout",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/startDate",
            "label": "First day"
          },
          {
            "type": "Control",
            "scope": "#/properties/endDate",
            "label": "Last day"
          }
        ]
      },
      {
        "type": "Control",
        "scope": "#/properties/destination",
        "label": "Destination"
      },
      {
        "type": "Control",
        "scope": "#/properties/note",
        "label": "Notes",
        "options": {
          "multi": true
        }
      }
    ]
  }
}
