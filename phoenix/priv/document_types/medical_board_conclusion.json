                "label": "Dentist: opinion"
              }
            ]
          },
          {
            "type": "HorizontalLayout",
            "options": {
              "widths": [
                2,
                1
              ]
            },
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/examinations/properties/dermatologist/properties/findings",
                "label": "Dermatologist: findings",
                "options": {
                  "multi": true
                }
              },
              {
                "type": "Control",
                "scope": "#/properties/examinations/properties/dermatologist/properties/opinion",
                "label": "Dermatologist: opinion"
              }
            ]
          }
        ]
      },
      {
        "type": "Group",
        "label": "Diagnosis",
        "elements": [
          {
            "type": "HorizontalLayout",
            "options": {
              "widths": [
                2,
                1
              ]
            },
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/mainDiagnosis/properties/text",
