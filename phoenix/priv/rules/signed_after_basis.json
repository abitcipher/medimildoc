{
  "key": "signed_after_basis",
  "version": 2,
  "label": "Signed after its basis",
  "description": "A document is signed no earlier than the document it is based on (a board conclusion after its referral, a leave order after the request, a discharge summary after the referral).",
  "severity": "flag",
  "points": [
    "document.sign"
  ],
  "subjects": [
    "document:medical_board_conclusion",
