# Copy to infra/.env and fill in real values:
#
#   cp infra/.env.example infra/.env
#
# infra/.env is gitignored — never commit it.

# The domain this app answers as. Two modes, picked
# purely by which value you put here — nothing else in this file changes:
#   - VPS mode (normal): the real deployed domain (e.g.
#     hrda.artcomplect.com) — Nginx on the VPS (infra/nginx/) already
#     reverse-proxies this straight to the `app` container. No tunnel
#     needed; leave the TUNNEL_* vars below unset and don't start the
#     `tunnel` compose profile.
#   - Local-dev mode: the dev subdomain (e.g. dev.hrda.artcomplect.com,
#     infra/nginx/dev.hrda.artcomplect.com.conf) — requires the `tunnel`
#     profile running (`docker compose --profile tunnel up`) and the
#     TUNNEL_* vars below filled in, so that subdomain has something on
#     the other end to reach.
# A DNS A (and/or AAAA) record for whichever host you use here must
# already point at the server terminating TLS for it before `docker
# compose up`, or certificate issuance fails.
PHX_HOST=app.example.com

POSTGRES_USER=app
POSTGRES_DB=app_prod
# openssl rand -hex 32 — NOT -base64: base64 can produce '/' or '+', and
# this value goes straight into DATABASE_URL below (ecto://user:pass@db/..)
# with no URL-encoding, so a '/' silently corrupts the parsed path and
# every migration/query fails at boot. Confirmed live.
POSTGRES_PASSWORD=

# mix phx.gen.secret (from phoenix/), or: openssl rand -base64 48
SECRET_KEY_BASE=

# Must match the Apps Script shim's SHARED_SECRET script property exactly
# (Project Settings -> Script properties in the Apps Script editor).
# Generate with: openssl rand -base64 32
SHEETS_SHARED_SECRET=

# Login for the standalone forms UI (/people, /organizations, /positions —
# Google OAuth, "just authenticated vs not"). Unrelated
# to SHEETS_SHARED_SECRET above (that's the embedded /sheets sidebar's
# separate HMAC-token trust boundary, no login screen at all).
#
# TOKEN_SIGNING_SECRET signs this app's own session JWTs — not a Google
# value. Generate with: openssl rand -base64 48
TOKEN_SIGNING_SECRET=
# From Google Cloud Console: APIs & Services -> Credentials -> Create
# Credentials -> OAuth client ID (Web application). Authorized redirect URI
# on that Google client must be https://<PHX_HOST>/auth/user/google/callback
# exactly. GOOGLE_REDIRECT_URI itself is the *base* URI AshAuthentication
# appends user/google/callback onto, not the callback URL itself — it must
# be .../auth/ (the router's "/auth" prefix, trailing slash), both
# confirmed live as required or the app crashes on the very first
# `/auth/user/google` request (missing "/auth" prefix, or a bare host with
# no trailing slash makes its URI.path `nil`).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://app.example.com/auth/

# docs/design/access-control-phase1.md : while true, role :admin can
# read and write every kind of data, medical and vetting included. Needed
# during development and testing; set to false (or remove) before go-live.
ADMIN_FULL_DATA_ACCESS=true

# docs/design/access-control-phase2.md §5: when true, granting a sensitive
# profile or the admin role needs a second administrator's approval. Keep
# false while there is a single admin; set true before go-live.
REQUIRE_SECOND_APPROVAL=false

# Encryption at rest for medical records, national ID numbers and document
# numbers (docs/design/access-control-phase1.md §5). Generate with:
#   openssl rand -base64 32
# Keep a copy somewhere other than this server: without it every encrypted
# field is unreadable. Rotation: infra/README.md.
CLOAK_KEY=

# File storage: RustFS credentials (docs/design/reference-data-and-files.md
# §4). Used by the rustfs container and the app. Generate with:
#   openssl rand -hex 16   (access key)   openssl rand -hex 32   (secret)
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

# Notifications (docs/design/search-timeline-notifications.md). RabbitMQ
# carries the outbox; generate the password with: openssl rand -hex 32
RABBITMQ_USER=hrda
RABBITMQ_PASSWORD=
# Links in messages; defaults to https://$PHX_HOST.
APP_URL=
# The sender of each channel as an Apprise URL (App.Notify.Apprise); leave
# a channel empty to not use it. Examples:
#   NOTIFY_EMAIL_URL=mailtos://user:password@smtp.example.com?from=noreply@example.com
#   NOTIFY_TELEGRAM_URL=tgram://123456:BOT-TOKEN
#   NOTIFY_SIGNAL_URL=signal://signal-api:8080/+380XXXXXXXXX
#   NOTIFY_MATRIX_URL=matrixs://user:password@matrix.example.org
NOTIFY_EMAIL_URL=
NOTIFY_TELEGRAM_URL=
NOTIFY_SIGNAL_URL=
NOTIFY_MATRIX_URL=

# Ecto pool size — 10 is a reasonable default for a 4 vCPU / 8 GB box
# running a single app instance; raise it only if you see connection-pool
# timeouts under real load.
POOL_SIZE=10

# Local-dev tunnel mode only — leave all three unset for
# VPS mode. Reverse-tunnels this locally-running app to the VPS so
# dev.hrda.artcomplect.com can reach it, replacing a third-party tunnel
# service (localtunnel/localhost.run — confirmed unreliable live) with
# infrastructure we already own.
#
# TUNNEL_SSH_KEY_PATH must be a DEDICATED key generated just for this
# (ssh-keygen -t ed25519 -N "" -f dev_tunnel_key), never your own login
# key — see infra/README.md for the exact authorized_keys line to add
# on the VPS that locks it down to forwarding only, no shell.
TUNNEL_USER=
TUNNEL_HOST=
TUNNEL_SSH_KEY_PATH=
# Must match both the VPS authorized_keys entry's `permitopen` port and
# infra/nginx/dev.hrda.artcomplect.com.conf's upstream port.
TUNNEL_REMOTE_PORT=5086
