<div class="max-w-md mx-auto p-4 flex flex-col gap-4" data-theme="dark">
  <div>
    <h1 class="text-xl font-semibold">Dev sign-in</h1>
    <p class="text-sm opacity-75">
      Local only (<code>dev_routes</code>) — mints a real session, no Google OAuth.
      The real <.link navigate={~p"/sign-in"} class="link">Sign in with Google</.link>
      page is untouched.
    </p>
  </div>

  <Layouts.flash_group flash={@flash} />

  <div :if={@users != []}>
    <h2 class="font-semibold mb-2">Existing users</h2>
    <p class="text-sm opacity-75 mb-2">
      <code>@demo.test</code>
      accounts come from <code>mix app.demo.seed</code>: one per role and access profile.
    </p>
    <ul class="flex flex-col gap-2">
      <li :for={user <- @users}>
        <form action={~p"/dev/sign-in"} method="post">
          <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
          <input type="hidden" name="email" value={user.email} />
          <input type="hidden" name="role" value={user.role} />
          <button type="submit" class="btn btn-sm w-full justify-between">
            <span>{user.email}</span>
            <span class="flex gap-1">
              <span class="badge badge-sm">{user.role}</span>
              <span :for={profile <- user.profiles} class="badge badge-sm badge-info">
                {profile}
              </span>
            </span>
          </button>
        </form>
      </li>
    </ul>
  </div>

  <div>
    <h2 class="font-semibold mb-2">New user</h2>
    <form action={~p"/dev/sign-in"} method="post" class="flex flex-col gap-2">
      <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
      <input
        type="email"
        name="email"
        placeholder="someone@example.com"
        class="input w-full"
        required
      />
      <select name="role" class="select w-full">
        <option :for={role <- @roles} value={role}>{role}</option>
      </select>
      <button type="submit" class="btn btn-primary">Sign in as this user</button>
    </form>
  </div>
</div>
