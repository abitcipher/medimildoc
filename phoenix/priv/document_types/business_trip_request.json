{
  "id": "business_trip_request",
  "version": "1",
  "label": "Business trip request",
  "icon": "hero-paper-airplane",
  "summary": "The person asks to be sent on a business trip; the commander approves, HR accepts and drafts the order.",
  "category": "personnel",
  "access": {
    "read": [
      "people.hr_private.read",
      "orders.sign"
    ],
    "write": "people.write",
    "self": true
  },
  "register": {
    "code": "рап",
    "format": "{seq}-{code}"
  },
  "retention_years": 5,
  "template": "leave_request.typ",
  "route": [
    {
      "action": "approve",
      "label": "Commander",
      "permission": "orders.sign"
    },
    {
      "action": "sign",
      "label": "HR",
      "permission": "people.write"
    }
  ],
  "effects": [
    "business_trip_order_draft"
  ],
  "basis": [],
  "schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": [
      "destination",
      "purpose",
      "startDate",
      "endDate"
    ],
    "properties": {
      "destination": {
        "type": "string",
        "maxLength": 300,
        "x-help": "Where the person goes: a unit, an organisation, a town."
      },
      "purpose": {
        "type": "string",
        "maxLength": 1000
      },
      "startDate": {
        "type": "string",
        "format": "date"
      },
      "endDate": {
        "type": "string",
        "format": "date"
      },
      "transport": {
        "type": "string",
        "enum": [
          "official_vehicle",
          "public_transport",
          "own_vehicle",
          "air",
          "other"
        ],
        "x-enum-labels": {
          "official_vehicle": "Official vehicle",
          "public_transport": "Public transport",
          "own_vehicle": "Own vehicle",
          "air": "Air",
          "other": "Other"
        }
      },
      "note": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "additionalProperties": false
  },
  "ui": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Control",
        "scope": "#/properties/destination",
        "label": "Destination"
      },
      {
        "type": "Control",
        "scope": "#/properties/purpose",
        "label": "Purpose",
        "options": {
          "multi": true
        }
      },
      {
        "type": "HorizontalLayout",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/startDate",
            "label": "First day"
          },
          {
            "type": "Control",
            "scope": "#/properties/endDate",
            "label": "Last day"
          }
        ]
      },
      {
        "type": "Control",
        "scope": "#/properties/transport",
        "label": "Transport"
      },
      {
        "type": "Control",
        "scope": "#/properties/note",
        "label": "Notes",
        "options": {
          "multi": true
        }
      }
    ]
  }
}
