{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DeputyAdmin",
  "type": "object",
  "required": ["user_id", "deputy_id"],
  "properties": {
    "user_id": { "type": "string", "x-help": "Whose approvals and signatures are covered." },
    "deputy_id": {
      "type": "string",
      "x-help": "Must hold at least one of the permissions the user approves or signs with."
    },
    "starts_on": { "type": "string", "format": "date" },
    "ends_on": { "type": "string", "format": "date" },
    "note": { "type": "string", "maxLength": 200 }
  }
}
