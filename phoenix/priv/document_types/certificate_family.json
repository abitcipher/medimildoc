{
  "id": "certificate_family",
  "version": "1",
  "label": "Family composition certificate",
  "icon": "hero-users",
  "summary": "Marital status, spouse and dependants as recorded; HR signs.",
  "category": "personnel_private",
  "access": {
    "read": [
      "people.hr_private.read"
    ],
    "write": "people.hr_private.write",
    "self": true
  },
  "register": {
    "code": "дов",
    "format": "{seq}-{code}"
  },
  "retention_years": 5,
  "template": "certificate.typ",
  "route": [
    {
      "action": "sign",
      "label": "HR",
      "permission": "people.hr_private.write"
    }
  ],
  "effects": [],
  "basis": [],
  "facts": "family",
  "schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": [],
    "properties": {
      "presentTo": {
        "type": "string",
        "maxLength": 300,
        "x-help": "Where the certificate will be presented; leave empty for \"wherever required\"."
      }
    },
    "additionalProperties": false
  },
  "ui": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Control",
        "scope": "#/properties/presentTo",
        "label": "To be presented at"
      }
    ]
  }
}
