<стовпець-статус>
#block[#table(
  columns: (22%, 46%, 32%),
  align: (col, row) => (auto,auto,auto,).at(col),
  inset: 6pt,
  [Позначка], [Колір], [Значення],
  [#strong[→]],
  [синій],
  [Буде виконано (після перевірки)],
  [#strong[✓]],
  [зелений],
  [Виконано],
  [#strong[!]],
  [бурштиновий],
  [Потребує уваги: рядок змінено ще й у системі; або пропущено, бо вже є
