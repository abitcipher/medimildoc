          "y": 200
        }
      },
      {
        "id": "check",
        "type": "expressionNode",
        "name": "No diagnosis code",
        "position": {
          "x": 300,
          "y": 200
        },
        "content": {
          "expressions": [
            {
              "id": "e1",
              "key": "valid",
              "value": "data.restrictions == null or not matches(data.restrictions, \"(^|[^A-Za-z0-9])[A-TV-Z][0-9][0-9]([^0-9]|$)\")"
            },
            {
              "id": "e2",
              "key": "code",
              "value": "(data.restrictions == null or not matches(data.restrictions, \"(^|[^A-Za-z0-9])[A-TV-Z][0-9][0-9]([^0-9]|$)\")) ? null : 'diagnosis_in_restrictions'"
            },
            {
              "id": "e3",
