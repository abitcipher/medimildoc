                "scope": "#/properties/examinations/properties/psychiatrist/properties/findings",
                "label": "Psychiatrist: findings",
                "options": {
                  "multi": true
                }
              },
              {
                "type": "Control",
                "scope": "#/properties/examinations/properties/psychiatrist/properties/opinion",
                "label": "Psychiatrist: opinion"
              }
            ]
          },
          {
            "type": "HorizontalLayout",
            "options": {
              "widths": [
                2,
                1
              ]
            },
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/examinations/properties/ophthalmologist/properties/findings",
                "label": "Ophthalmologist: findings",
                "options": {
                  "multi": true
                }
              },
              {
                "type": "Control",
                "scope": "#/properties/examinations/properties/ophthalmologist/properties/opinion",
                "label": "Ophthalmologist: opinion"
              }
            ]
          },
          {
            "type": "HorizontalLayout",
