{
  "type": "VerticalLayout",
  "elements": [
    { "type": "Control", "scope": "#/properties/name", "label": "Name" },
    {
      "type": "HorizontalLayout",
      "elements": [
        { "type": "Control", "scope": "#/properties/provider_type", "label": "Type" },
        { "type": "Control", "scope": "#/properties/registry_code", "label": "Registry code" }
      ]
    },
    { "type": "Control", "scope": "#/properties/priority", "label": "Our own unit (priority)" },
    { "type": "Control", "scope": "#/properties/organization_id", "label": "Unit" },
