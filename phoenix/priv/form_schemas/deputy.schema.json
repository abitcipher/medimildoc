{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Deputy",
  "type": "object",
  "required": ["deputy_id"],
  "properties": {
    "deputy_id": { "type": "string" },
    "starts_on": { "type": "string", "format": "date" },
    "ends_on": { "type": "string", "format": "date" },
    "note": { "type": "string", "maxLength": 200 }
  }
}
