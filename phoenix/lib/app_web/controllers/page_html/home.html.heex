<%= if @current_user do %>
  <Layouts.app flash={@flash} current_user={@current_user}>
    <div class="mx-auto flex max-w-4xl flex-col gap-6 p-4">
      <.inbox inbox={@inbox} />
      <div :if={@widgets != []} class="grid grid-cols-1 gap-3 md:grid-cols-2">
        <.widget :for={{name, data} <- @widgets} name={name} data={data} conn={@conn} />
      </div>
      <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
        <li :for={item <- start_items(@current_user)}>
          <.link
            navigate={item["path"]}
            class="flex h-full items-start gap-3 rounded-box border border-base-300 bg-base-100 p-4 transition hover:border-primary hover:shadow-sm focus-visible:outline-2 focus-visible:outline-primary"
          >
            <span class="grid size-10 shrink-0 place-items-center rounded-full bg-base-200">
              <.icon name={item["icon"]} class="size-5" />
            </span>
            <span>
              <span class="block font-medium">{AppWeb.NavSchema.label(item)}</span>
              <span :if={item["description"]} class="block text-sm opacity-70">
                {Gettext.gettext(AppWeb.Gettext, item["description"])}
              </span>
            </span>
          </.link>
        </li>
      </ul>
    </div>
  </Layouts.app>
<% else %>
  <div class="flex min-h-screen flex-col bg-base-200">
    <div class="flex justify-end gap-1 p-3">
      <AppWeb.HeaderControls.language_menu />
      <AppWeb.HeaderControls.theme_menu />
    </div>
    <main class="flex grow items-center justify-center p-4">
      <div class="w-full max-w-sm rounded-box border border-base-300 bg-base-100 p-6 text-center shadow-sm">
        <span class="mx-auto grid size-14 place-items-center rounded-full bg-primary text-primary-content">
          <.icon name="hero-users" class="size-7" />
        </span>
        <h1 class="mt-4 text-xl font-semibold">HR Admin</h1>
        <.link navigate={~p"/sign-in"} class="btn btn-primary mt-6 w-full">
          <.icon name="hero-arrow-right-end-on-rectangle" class="size-5" />
          {gettext("Sign in")}
        </.link>
      </div>
    </main>
    <Layouts.flash_group flash={@flash} />
  </div>
<% end %>
